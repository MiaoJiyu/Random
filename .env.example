# 云端 MySQL 连接配置（示例模板，复制为 .env 后填写真实值）
# 数据库主机
DB_HOST=your_ip
# 端口
DB_PORT=3306
# 用户名
DB_USER=random
# 密码
DB_PASSWORD=your_passwd
# 数据库名
DB_NAME=random
# 连接池大小
DB_CONNECTION_LIMIT=10

# 后端服务监听端口（仅网页版独立启动时生效；Electron 由主进程自动分配空闲端口）
PORT=3000
# 监听地址：0.0.0.0 允许局域网其他设备访问；仅本机用 127.0.0.1
HOST=0.0.0.0
# 网页版启动后是否自动打开浏览器（false 关闭，适用于无桌面/服务部署）
OPEN_BROWSER=true
